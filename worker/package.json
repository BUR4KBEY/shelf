{
  "name": "shelf-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build --config dashboard/vite.config.ts",
    "dev": "wrangler d1 migrations apply DB --local && wrangler dev",
    "deploy": "wrangler deploy && wrangler d1 migrations apply DB --remote",
    "types": "wrangler types",
    "test": "pnpm run build && vitest run",
    "typecheck": "tsc",
    "typecheck:dashboard": "tsc -p dashboard",
    "setup:access": "node scripts/setup-access.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.9.1",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.78.0",
    "motion": "^14.14.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.1",
    "wrangler": "^4.167.0"
  },
  "dependencies": {
    "marked": "^18.2.1"
  },
  "packageManager": "pnpm@12.9.0"
}
