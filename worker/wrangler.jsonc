{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shelf",
  "main": "src/index.ts",
  // The dashboard is a React app built into src/dashboard.html, which the Worker imports as text.
  // watch_dir keeps `wrangler dev` from rebuilding on its own output in src/.
  "build": { "command": "npm run build", "watch_dir": "dashboard" },
  "compatibility_date": "2026-11-20",
  // No IDs: wrangler (and the Deploy to Cloudflare button) creates the bucket and database on first deploy.
  "r2_buckets": [{ "binding": "BUCKET" }],
  "d1_databases": [{ "binding": "DB", "database_name": "shelf" }],
  // Password attempts per IP and doc.
  "ratelimits": [{ "name": "UNLOCK_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  // Daily: delete expired docs and blobs nothing references.
  "triggers": { "crons": ["17 3 * * *"] },
  // Local `wrangler dev` only: pretend Cloudflare Access signed this user in, so the dashboard works offline.
  "access": { "dev": { "aud": "local-dev", "identity": { "email": "you@localhost" } } },
  // PR previews (`wrangler preview`, see .github/workflows/preview.yml) on workers.dev. Previews inherit no bindings,
  // so they get their own bucket and database: preview code never touches production docs or keys.
  "preview_urls": true,
  "previews": {
    // ctx.access is unset on Preview URLs, so the Worker verifies the Access JWT against these (see src/access.ts).
    // From the Access app that "Protect this Worker behind Access → Previews only" created.
    "vars": { "ACCESS_TEAM_DOMAIN": "burakbey.cloudflareaccess.com", "ACCESS_AUD": "89b8483308e308b90dd03baae956a3e448f62d658ec87b095ac38ee8f7946cbe" },
    "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "shelf-preview" }],
    // Same database as wrangler.preview-migrations.jsonc, which applies migrations to it.
    "d1_databases": [{ "binding": "DB", "database_name": "shelf-preview", "database_id": "7e32ae96-174c-4c79-bd91-fb5317eb1df6" }],
    "ratelimits": [{ "name": "UNLOCK_LIMIT", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }]
  }
}
